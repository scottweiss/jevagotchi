{
  "name": "jevagotchi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run --exclude '**/live.test.ts'",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/web --noEmit && tsc -p apps/server --noEmit",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "test:live": "node --env-file-if-exists=.env node_modules/.bin/vitest run packages/core/test/live.test.ts",
    "dev": "npm run dev:server & npm run dev:web",
    "dev:server": "node --env-file-if-exists=.env node_modules/.bin/vite-node apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "test:e2e": "node --test e2e/smoke.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
